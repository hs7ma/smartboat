# Tigris eye Server - Environment Variables

# Server Port (Railway sets this automatically)
PORT=3000

# OpenAI API Key (required for AI image analysis)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Supabase (image storage + review gallery)
# Project URL from Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
# Service role key (server only — never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
